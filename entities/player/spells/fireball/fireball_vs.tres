code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float noise_speed = 0.5;
uniform sampler2D noise_map : repeat_enable;



void fragment() {
// ColorConstant:14
	vec4 n_out14p0 = vec4(1.000000, 0.000000, 0.000000, 1.000000);


// ColorConstant:16
	vec4 n_out16p0 = vec4(1.000000, 0.266667, 0.000000, 1.000000);


// Input:2
	float n_out2p0 = TIME;


// FloatParameter:6
	float n_out6p0 = noise_speed;


// FloatOp:7
	float n_out7p0 = n_out2p0 * n_out6p0;


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = vec2(n_out7p0) * n_in5p1 + UV;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(noise_map, n_out5p0);


// Mix:17
	vec3 n_out17p0 = mix(vec3(n_out14p0.xyz), vec3(n_out16p0.xyz), vec3(n_out4p0.xyz));


// Output:0
	ALBEDO = n_out17p0;
	EMISSION = n_out17p0;


}
