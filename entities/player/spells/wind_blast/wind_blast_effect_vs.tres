[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float displacement_speed = 1;
uniform sampler2D tex_vtx_2;
uniform float displacement_scale = 0.40000000596046;
uniform float normal_offset = 0;
uniform vec4 base_color : source_color = vec4(0.757934, 0.930209, 1.000000, 1.000000);
uniform float alpha = 0.20000000298023;



void vertex() {
// Input:3
	vec3 n_out3p0 = VERTEX;


// Input:6
	vec3 n_out6p0 = NORMAL;


// Input:8
	float n_out8p0 = TIME;


// FloatParameter:11
	float n_out11p0 = displacement_speed;


// FloatOp:12
	float n_out12p0 = n_out8p0 * n_out11p0;


// UVFunc:7
	vec2 n_in7p1 = vec2(1.00000, 1.00000);
	vec2 n_out7p0 = vec2(n_out12p0) * n_in7p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_vtx_2, n_out7p0);


// FloatParameter:10
	float n_out10p0 = displacement_scale;


// FloatOp:9
	float n_out9p0 = n_out2p0.x * n_out10p0;


// FloatParameter:14
	float n_out14p0 = normal_offset;


// VectorOp:13
	vec3 n_out13p0 = vec3(n_out9p0) - vec3(n_out14p0);


// VectorOp:5
	vec3 n_out5p0 = n_out6p0 * n_out13p0;


// VectorOp:4
	vec3 n_out4p0 = n_out3p0 + n_out5p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = base_color;


// FloatParameter:3
	float n_out3p0 = alpha;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out3p0;


}
