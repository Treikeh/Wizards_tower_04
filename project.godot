[layer_names]

3d_physics/layer_1="static"
3d_physics/layer_2="physics"
3d_physics/layer_3="player"
3d_physics/layer_4="enemy"
3d_physics/layer_5="interaction"
3d_physics/layer_6="projectile"
3d_navigation/layer_6="projectile"
3d_physics/layer_7="player_hitbox"
3d_physics/layer_8="enemy_hitbox"
3d_physics/layer_10="camera_shake"
3d_physics/layer_13="projectile_hitbox"

[limbo_ai]

behavior_tree/behavior_tree_default_dir="res://common/behavior_trees"
behavior_tree/user_task_dir_1="res://common/scripts/ai_tasks"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=12.5

[rendering]

textures/canvas_textures/default_texture_filter=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/screen_space_roughness_limiter/enabled=false
