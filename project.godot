; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wizards_tower_4.3"
config/description="Enter an interesting project description here!"
config/tags=PackedStringArray("proper_project")
run/main_scene="res://main_scene.tscn"
config/features=PackedStringArray("4.3")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Globals="*res://common/scripts/autoload/globals.gd"
ConfigHandler="*res://common/scripts/autoload/config_handler.gd"
BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="viewport"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "pink",
"res://common/": "gray",
"res://entities/": "blue",
"res://interface/": "green",
"res://levels/": "orange"
}

[global_group]

player=""
enemy=""
navigation_mesh_source_group=""
fireball=""

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input]

move_f={
