code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 displacement_speed = vec2(0.000000, 0.500000);
uniform sampler2D displacement_texture;
uniform float displacement_scale = 0.30000001192093;
uniform vec4 base_color : source_color = vec4(0.901961, 0.396078, 0.000000, 1.000000);
uniform float alpha = 0.25;
uniform float emission_strength = 1;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:3
	vec3 n_out3p0 = NORMAL;


// Input:8
	float n_out8p0 = TIME;


// Vector2Parameter:14
	vec2 n_out14p0 = displacement_speed;


// VectorOp:13
	vec2 n_out13p0 = vec2(n_out8p0) * n_out14p0;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = n_out13p0 * n_in9p1 + UV;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(displacement_texture, n_out9p0);


// FloatParameter:12
	float n_out12p0 = displacement_scale;


// FloatOp:7
	float n_out7p0 = n_out6p0.x * n_out12p0;


// VectorOp:5
	vec3 n_out5p0 = n_out3p0 * vec3(n_out7p0);


// VectorOp:4
	vec3 n_out4p0 = n_out2p0 + n_out5p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = base_color;


// FloatParameter:3
	float n_out3p0 = alpha;


// FloatParameter:4
	float n_out4p0 = emission_strength;


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out2p0.xyz) * vec3(n_out4p0);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out3p0;
	EMISSION = n_out5p0;


}
"
