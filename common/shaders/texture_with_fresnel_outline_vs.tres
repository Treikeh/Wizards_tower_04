[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_toon, specular_toon, shadows_disabled;

uniform vec4 base_color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform sampler2D base_color_map : source_color;
uniform float metalic : hint_range(0.0, 1.0) = 0.0;
uniform float roughness : hint_range(0.0, 1.0) = 1.0;
uniform vec4 frensel_color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float fresnel_power = 3.0;
uniform sampler2D frensel_gradient;



void fragment() {
// ColorParameter:23
	vec4 n_out23p0 = base_color;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(base_color_map, UV);


// VectorOp:24
	vec3 n_out24p0 = vec3(n_out23p0.xyz) * vec3(n_out3p0.xyz);


// FloatParameter:22
	float n_out22p0 = metalic;


// FloatParameter:21
	float n_out21p0 = roughness;


// ColorParameter:19
	vec4 n_out19p0 = frensel_color;


// Input:5
	vec3 n_out5p0 = NORMAL;


// Input:6
	vec3 n_out6p0 = VIEW;


// FloatParameter:7
	float n_out7p0 = fresnel_power;


// Fresnel:4
	float n_out4p0 = pow(1.0 - clamp(dot(n_out5p0, n_out6p0), 0.0, 1.0), n_out7p0);


// VectorCompose:16
	float n_in16p1 = 0.00000;
	vec2 n_out16p0 = vec2(n_out4p0, n_in16p1);


	vec4 n_out15p0;
// Texture2D:15
	n_out15p0 = texture(frensel_gradient, n_out16p0);


// FloatOp:13
	float n_out13p0 = n_out4p0 * n_out15p0.x;


// VectorOp:20
	vec3 n_out20p0 = vec3(n_out19p0.xyz) * vec3(n_out13p0);


// Output:0
	ALBEDO = n_out24p0;
	METALLIC = n_out22p0;
	ROUGHNESS = n_out21p0;
	EMISSION = n_out20p0;


}
